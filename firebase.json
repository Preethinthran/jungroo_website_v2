{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/stack", "destination": "/stack.html" },
      { "source": "/case-studies", "destination": "/case-studies.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
